    "start": "node src/main.ts",
    "mutations": "node scripts/mutation-check.ts",
    "browsers": "scripts/browser-sweep.sh"
  },
  "dependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "playwright": "1.56.1",
    "typescript": "^5.7.0"
  }
}
