{
  "name": "telco",
  "version": "0.1.0",
  "private": true,
  "description": "Airtime and data transfer between Nigerian mobile networks",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "migrate": "node src/migrate.ts",
