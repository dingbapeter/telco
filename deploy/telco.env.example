# Copy to /etc/telco/telco.env, fill in, then: sudo chmod 600 /etc/telco/telco.env
# The database connection string. The password is set when the database user is created.
DATABASE_URL=postgres://telco:CHANGE_ME@127.0.0.1:5432/telco
# Where the service listens; Caddy connects here.
PORT=3000
HOST=127.0.0.1
# The public address, with https. Cookies are marked secure when it starts with https.
PUBLIC_BASE_URL=https://your.domain
# Top-up provider (VTpass). Leave out until you have an account; payouts are then done by hand.
# Get the keys at vtpass.com under API keys. Use sandbox first, then live.
#VTPASS_ENV=sandbox
#VTPASS_API_KEY=
#VTPASS_SECRET_KEY=
#VTPASS_PUBLIC_KEY=
# How buyers pay by card. Leave both out to take bank transfers only.
#
# Flutterwave is the one in use when its key is here, and it takes cards issued
# outside Nigeria as well as Nigerian ones. Get the secret key at
# flutterwave.com under Settings, API. Test keys have TEST in them.
#FLUTTERWAVE_SECRET_KEY=
# The secret hash you type into Flutterwave under Settings, Webhooks, where the
# address is https://your.domain/payments/flutterwave/webhook. Make it long and
# random. Without it a buyer who pays and closes the tab waits for somebody to
# look, because no webhook is believed.
#FLUTTERWAVE_WEBHOOK_SECRET=
# Paystack still works and is used when Flutterwave's key is absent. Get the
# secret key at paystack.com under Settings, API keys. Test keys start sk_test_.
#PAYSTACK_SECRET_KEY=
