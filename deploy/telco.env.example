# Copy to /etc/telco/telco.env, fill in, then: sudo chmod 600 /etc/telco/telco.env
# The database connection string. The password is set when the database user is created.
DATABASE_URL=postgres://telco:CHANGE_ME@127.0.0.1:5432/telco
# Where the service listens; Caddy connects here.
PORT=3000
HOST=127.0.0.1
# The public address, with https. Cookies are marked secure when it starts with https.
PUBLIC_BASE_URL=https://your.domain
